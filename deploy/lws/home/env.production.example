#--------------------------------------------------------------------
# LWS production — placer ce fichier sur le serveur à :
# kishala-trans.cadriciel.com/home/.env
# (jamais versionné ni déployé par le CI)
#--------------------------------------------------------------------

CI_ENVIRONMENT = production
app.baseURL = 'https://kishala-trans.cadriciel.com/'
app.forceGlobalSecureRequests = true

database.default.hostname = localhost
database.default.database = cadri2834001
database.default.username = cadri2834001
database.default.password = 'CHANGER_MOT_DE_PASSE'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

encryption.key = hex2bin:GENERER_AVEC_php_spark_key_generate

jwt.secret = CHANGER_SECRET_JWT_PRODUCTION
jwt.algorithm = HS256
jwt.issuer = kishalatrans-api
jwt.audience = kishalatrans-client
jwt.accessTokenTtl = 900
jwt.refreshTokenTtl = 604800
